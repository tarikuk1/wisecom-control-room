# Wisecom Control Room — variables d'environnement
# Copier ce fichier en .env (ne pas committer .env dans git)
# Sur Railway : configurer ces variables dans l'onglet Variables du projet.

# Identifiants INO (API Unicity)
INO_LOGIN=tarik_dashboard
INO_PWD=CHANGE_ME
INO_APIKEY=CHANGE_ME

# Code de sécurité 2FA partagé (6 chiffres)
SECURITY_CODE=CHANGE_ME

# Utilisateurs superviseurs (format login:mdp séparés par virgule)
USERS=login1:motdepasse1,login2:motdepasse2

# Secret pour le webhook /webhook (laisser vide = webhook ouvert)
WEBHOOK_SECRET=CHANGE_ME

# Port d'écoute (par défaut 3000)
PORT=3000
